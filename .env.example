# Copy to .env and fill in the token. Never commit .env.
MONDAY_API_TOKEN=
MONDAY_API_VERSION=2026-07
MONDAY_API_URL=https://api.monday.com/v2
MCP_LOG_LEVEL=info
MCP_HTTP_TIMEOUT=15s
MCP_MAX_RESPONSE_BYTES=4194304
MCP_MAX_RETRIES=2
# Workspace scope (see docs/CAPABILITIES.md#workspace-scope): numeric ID of the
# only workspace the server may read or write. Names are not unique in monday,
# so an ID is required. Empty = unscoped (pick a workspace per request).
MONDAY_WORKSPACE_ID=
# Write policy (see docs/CAPABILITIES.md)
# true hides every write tool
MCP_READ_ONLY=false
# comma-separated board IDs allowed for mutations (empty = no restriction)
MONDAY_WRITE_BOARD_ALLOWLIST=
# comma-separated workspace IDs allowed for board/folder creation
MONDAY_WRITE_WORKSPACE_ALLOWLIST=
# max items a report loads per board (1-5000)
MCP_REPORT_MAX_ITEMS=500
