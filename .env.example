# ── mcp-monday-projects configuration ────────────────────────────────────────
#
#   cp .env.example .env      # then fill in MONDAY_API_TOKEN
#
# Reference: README.md#configuration and docs/CAPABILITIES.md
# ⚠️  NEVER commit .env — it holds credentials and is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Authentication ───────────────────────────────────────────────────────────
#
# Personal API token (monday → avatar → Developers → My access tokens).
# Every action is attributed to the token's owner, with that user's rights.
MONDAY_API_TOKEN=

# ── API ──────────────────────────────────────────────────────────────────────
MONDAY_API_VERSION=2026-07
MONDAY_API_URL=https://api.monday.com/v2

# ── Runtime limits ───────────────────────────────────────────────────────────
# Log level for stderr: debug | info | warn | error.
MCP_LOG_LEVEL=info
MCP_HTTP_TIMEOUT=15s
MCP_MAX_RESPONSE_BYTES=4194304
MCP_MAX_RETRIES=2

# ── Model-facing server instructions ─────────────────────────────────────────
# Optional replacement for the built-in MCP instructions. Maximum 4000 chars.
MCP_SERVER_INSTRUCTIONS=

# ── Access level ─────────────────────────────────────────────────────────────
#
# Decides WHICH TOOLS are registered; hidden tools are invisible to the client.
#
#   read   read tools only (reports, search, schema). Nothing can change.
#   write  DEFAULT. create / update / move / archive. Archive remains
#          recoverable in monday; no permanent deletes.
#   full   write + delete_* tools that PERMANENTLY delete items, groups,
#          columns, boards, updates, folders and workspaces. Every delete
#          requires confirm=true and still obeys the scope and allowlists.
#
# MCP_READ_ONLY was removed in v1.0.0. Use MCP_ACCESS_LEVEL=read instead.
MCP_ACCESS_LEVEL=write
# Optional comma-separated tool names. Empty = expose all tools allowed by
# MCP_ACCESS_LEVEL. Read tools are unaffected; unknown names fail at startup.
MCP_WRITE_TOOL_ALLOWLIST=

# ── Workspace scope ──────────────────────────────────────────────────────────
#
# Numeric ID of the ONLY workspace the server may read or write
# (docs/CAPABILITIES.md#workspace-scope). Names are not unique in monday, so
# an ID is required. Empty = account-wide: the client picks a workspace per
# request or asks you after calling list_workspaces.
MONDAY_WORKSPACE_ID=

# ── Write allowlists ─────────────────────────────────────────────────────────
#
# Comma-separated IDs. Empty = no extra restriction.
# Board allowlist: mutations only on these boards (items resolve to their board).
MONDAY_WRITE_BOARD_ALLOWLIST=
# Workspace allowlist: board/folder creation only in these workspaces.
MONDAY_WRITE_WORKSPACE_ALLOWLIST=

# ── Reports ──────────────────────────────────────────────────────────────────
# Max items a report loads per board (1-5000).
MCP_REPORT_MAX_ITEMS=500

# ── Profiles ─────────────────────────────────────────────────────────────────
#
# Optional: select profiles/<name>.env, which pins a target (token reference,
# workspace, access level, tool allowlist, and write allowlists) and wins over
# the values above.
# Copy profiles/example.env to start. Mount the directory at /profiles.
# See docs/CAPABILITIES.md#profiles.
MCP_PROFILE=
# MCP_PROFILES_DIR=/profiles

# ── Access level examples ────────────────────────────────────────────────────
#
# Copy one preset over the matching lines above.
#
#   # 1. Read-only analyst: dashboards and reports, nothing can change.
#   MCP_ACCESS_LEVEL=read
#   MONDAY_WORKSPACE_ID=<workspace id>
#
#   # 2. Write (default): day-to-day work in one team's workspace, archive only.
#   MCP_ACCESS_LEVEL=write
#   MONDAY_WORKSPACE_ID=<workspace id>
#
#   # 3. Full control: also permanent deletes (confirm=true on every call).
#   #    Keep a scope or allowlist so a wrong ID cannot hit another team.
#   MCP_ACCESS_LEVEL=full
#   MONDAY_WORKSPACE_ID=<workspace id>
#   MONDAY_WRITE_BOARD_ALLOWLIST=<board id>,<board id>
