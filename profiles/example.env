# Example profile. Copy to profiles/<name>.env and select it with
#   MCP_PROFILE=<name>
# A profile pins one monday target. Keys set here win over the environment;
# keys left out fall back to it. Tokens never go in this file.
# See docs/CAPABILITIES.md#profiles.

# Environment variable that holds this account's API token.
# Omit to use MONDAY_API_TOKEN.
MONDAY_API_TOKEN_ENV=MONDAY_TOKEN_EXAMPLE

# Target and policy
MONDAY_WORKSPACE_ID=123456
MCP_ACCESS_LEVEL=read
# MONDAY_WRITE_BOARD_ALLOWLIST=
# MONDAY_WRITE_WORKSPACE_ALLOWLIST=
# MCP_REPORT_MAX_ITEMS=500
# MONDAY_API_VERSION=2026-07
